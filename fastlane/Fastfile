require "base64"

default_platform(:ios)

APP_IDENTIFIER = "com.immform.notesorganizer"
SHARE_EXTENSION_IDENTIFIER = "com.immform.notesorganizer.share"

platform :ios do
  desc "Build and upload a TestFlight beta"
  lane :beta do
    setup_ci

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      readonly: false,
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['MATCH_GIT_TOKEN']}")
    )

    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    # project.yml regenerates NotesOrganizer.xcodeproj on every CI run, so
    # the build number can't be set with agvtool (it would be clobbered by
    # the next `xcodegen generate`). Passing it as an xcarg overrides
    # CURRENT_PROJECT_VERSION for every target in the build, app and share
    # extension alike, without touching project.yml.
    build_app(
      scheme: "NotesOrganizer",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"],
          SHARE_EXTENSION_IDENTIFIER => ENV["sigh_#{SHARE_EXTENSION_IDENTIFIER}_appstore_profile-name"]
        }
      }
    )

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
